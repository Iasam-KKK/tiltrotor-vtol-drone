# Load the tri-tiltrotor STEP assembly into FreeCAD, named and colour-coded.
#
# Blender shows triangle soup: everything is grey, nothing has an identity, and
# you cannot measure anything. FreeCAD keeps each STEP part as real geometry --
# clickable, named, sectionable, measurable. That is what makes it possible to
# answer "what is this and does it fit" rather than squinting at a silhouette.
#
# Run:  FreeCAD -> Macro -> Macros... -> load_assembly.FCMacro -> Execute
# or:   powershell -File tools/open_in_freecad.ps1
import os
import FreeCAD as App
import FreeCADGui as Gui
import Part

HERE = os.path.dirname(__file__)
ASSY = os.path.abspath(os.path.join(HERE, "..", "cad", "out", "assembly"))

# Colour by ROLE, so the picture answers a question instead of being decorative.
COLORS = {
    "structure": (0.15, 0.15, 0.18),   # carbon: rods and spars
    "formers":   (0.90, 0.55, 0.10),   # printed bulkheads
    "linkages":  (0.85, 0.15, 0.15),   # control runs
    "aileron":   (0.20, 0.60, 0.90),   # moving surfaces
    "ruddervat": (0.20, 0.60, 0.90),
    "nacelle":   (0.55, 0.35, 0.75),   # printed nacelle hardware
    "tail_moto": (0.55, 0.35, 0.75),
    "prop":      (0.35, 0.35, 0.38),
}
DEFAULT = (0.82, 0.84, 0.86)           # shells
TRANSPARENT = ("fuselage", "wing", "tail")   # so the internals are visible

doc = App.newDocument("tri_tiltrotor")

files = sorted(f for f in os.listdir(ASSY) if f.lower().endswith(".step"))
if not files:
    raise RuntimeError("no STEP files -- run cad/gen_assembly_step.py first")

for fn in files:
    name = os.path.splitext(fn)[0]
    shape = Part.Shape()
    shape.read(os.path.join(ASSY, fn))
    # Parts exported in millimetres carry an _mm suffix; FreeCAD works in mm,
    # so the metre parts need scaling up. Getting this backwards puts a 2 m
    # wing next to a 2 mm one and nothing lines up.
    if not name.endswith("_mm"):
        m = App.Matrix()
        m.scale(1000.0, 1000.0, 1000.0)
        shape = shape.transformGeometry(m)
    obj = doc.addObject("Part::Feature", name)
    obj.Shape = shape

    col = DEFAULT
    for key, c in COLORS.items():
        if name.startswith(key):
            col = c
            break
    obj.ViewObject.ShapeColor = col
    if any(name.startswith(t) for t in TRANSPARENT):
        obj.ViewObject.Transparency = 72

doc.recompute()
Gui.activeDocument().activeView().viewIsometric()
Gui.SendMsgToActiveView("ViewFit")

App.Console.PrintMessage(
    "\nLoaded %d parts.\n"
    "  dark grey  = carbon structure (longerons, tail boom, wing spars)\n"
    "  orange     = printed formers / internal mounts\n"
    "  red        = control linkages\n"
    "  blue       = moving surfaces\n"
    "  purple     = printed nacelle hardware\n"
    "  shells are 72%% transparent so the internals show.\n" % len(files))
