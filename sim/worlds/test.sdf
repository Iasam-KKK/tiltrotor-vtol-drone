<?xml version="1.0" ?>
<!--
  Minimal validation world for the tri-tiltrotor.

  This file is hand-written and contains NO design dimensions: everything
  geometric lives in cad/params.py and reaches the simulator through the
  generated model. Keep it that way.

  The sensor systems below are not optional decoration. A <sensor> in a model
  produces nothing at all unless the matching world system is loaded, and it
  fails silently -- the topic simply never appears. AirSpeed in particular is
  what PX4 gates VTOL transition on.
-->
<sdf version="1.9">
  <world name="test">

    <physics name="1ms" type="ignored">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-air-speed-system"
            name="gz::sim::systems::AirSpeed"/>
    <plugin filename="gz-sim-magnetometer-system"
            name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system"
            name="gz::sim::systems::NavSat"/>
    <!--
      NO gz-sim-sensors-system here, on purpose.
      That system is what initialises the RENDER context, and rendering is
      what is broken in this environment: with a camera in the scene the
      server segfaults during "Create scene" under both ogre and ogre2, and
      the stock PX4 x500 model crashes identically. It is not our geometry.

      This world exists to validate STRUCTURE and PHYSICS, neither of which
      needs a renderer. IMU, air pressure, airspeed, magnetometer and navsat
      each have their own system and work fine without one; only cameras
      require Sensors. Rendering happens in worlds/capture.sdf, which is a
      separate concern and a separate script.
    -->


    <gravity>0 0 -9.80665</gravity>
    <magnetic_field>6.0e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>24.8607</latitude_deg>
      <longitude_deg>67.0011</longitude_deg>
      <elevation>8</elevation>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.4 0.45 0.4 1</ambient>
            <diffuse>0.4 0.5 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <include>
      <uri>model://tri_tiltrotor</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
